# --- Database (Postgres: Neon / Supabase / Vercel Marketplace) ---
# Хоосон орхивол local хөгжүүлэлтэд .data/pglite суурилсан database автоматаар ашиглагдана.
DATABASE_URL=

# --- Jira ---
JIRA_BASE_URL=https://company.atlassian.net
# Jira Cloud: имэйл + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
# Jira Server / Data Center: JIRA_EMAIL-г хоосон орхиж, JIRA_API_TOKEN-д Personal Access Token
JIRA_EMAIL=
JIRA_API_TOKEN=
# cloud | server
JIRA_DEPLOYMENT=cloud
# Татах task-уудын шүүлтүүр (ORDER BY бичихгүй)
JIRA_JQL=project = IT
# Story Points болон Sprint талбарын ID (Jira → Settings → Issues → Custom fields)
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_SPRINT_FIELD=customfield_10020
# Анхны татахад хэдэн хоногийн өмнөх task-ыг авах
JIRA_INITIAL_DAYS=120
# «Дууссан» гэж тооцох төлөвүүд (дахин нээлтийг илрүүлэхэд)
JIRA_DONE_STATUSES=Done, Closed, Resolved, Дууссан, Хийгдсэн, Хаагдсан

# --- Security ---
# Вэбэд нэвтрэх нэр, нууц үг (Basic Auth). Production-д заавал.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Vercel Cron-ийн нууц түлхүүр (Vercel автоматаар Authorization: Bearer <CRON_SECRET> илгээнэ)
CRON_SECRET=

# Зөвхөн дотоод сүлжээ/оффисын IP-аар хязгаарлах (таслалаар зааглан олон IP эсвэл CIDR бичиж болно).
# Хоосон орхивол IP шалгахгүй, зөвхөн Basic Auth ажиллана.
# Жишээ: ALLOWED_IPS=202.131.233.10, 202.131.233.0/24
ALLOWED_IPS=

# --- Other ---
# Багийн цагийн бүс, минутаар (Улаанбаатар = 480)
APP_TZ_OFFSET_MINUTES=480
